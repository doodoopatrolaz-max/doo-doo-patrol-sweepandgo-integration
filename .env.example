# App
NODE_ENV=development
PORT=3000
WEBHOOK_PATH_SECRET=replace-with-sweepandgo-webhook-path-secret

# Database
DATABASE_URL=postgresql://placeholder-user:placeholder-password@placeholder-host:5432/placeholder-database

# Sweep&Go
# Leave this blank for the first Railway deployment. Add it only after Sweep&Go generates the token.
SWEEPGO_API_TOKEN=
SWEEPGO_BASE_URL=https://confirm-sweepandgo-base-url.example

# Provider webhook placeholders. Keep real values only in Railway or a private local env file.
GOHIGHLEVEL_WEBHOOK_SECRET=
GMAIL_WEBHOOK_SECRET=
META_ADS_WEBHOOK_SECRET=
GOOGLE_ADS_WEBHOOK_SECRET=

# Gmail read-only source evidence lookup. Do not add real credentials to this file.
# Required only when enabling automatic Sweep&Go new-client email source capture.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=me
GMAIL_API_SCOPE=https://www.googleapis.com/auth/gmail.readonly
GMAIL_API_BASE_URL=https://gmail.googleapis.com
GMAIL_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token

# GoHighLevel reporting discovery placeholders. Do not add real credentials to this file.
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
GHL_PIPELINE_ID=
GHL_PIPELINE_NAME=Fresh Leads to Onboarding
GHL_FACEBOOK_STAGE_ID=
GHL_FACEBOOK_STAGE_NAME=Facebook New Lead
GHL_WEBSITE_STAGE_ID=
GHL_WEBSITE_STAGE_NAME=Website Quote Lead

# KPI TRACKER / Lead Context Builder forwarding placeholders. Do not add real secrets to this file.
LEADCONTEXT_WEBSITE_LEAD_URL=https://leadcontext-production.up.railway.app/webhooks/website/lead
LEADCONTEXT_ONBOARDING_COMPLETE_URL=https://leadcontext-production.up.railway.app/webhooks/sweepgo/onboarding-complete
LEADCONTEXT_ONBOARDING_COMPLETE_SECRET=

# Meta Ads read-only reporting placeholders. Do not add real credentials to this file.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v23.0
META_API_BASE_URL=https://graph.facebook.com
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=

# Google Ads read-only reporting placeholders. Do not add real credentials to this file.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_MANAGER_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_API_VERSION=v24
GOOGLE_ADS_API_BASE_URL=https://googleads.googleapis.com
GOOGLE_ADS_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token

# Private KPI dashboard. Store the real password only in Railway or a private local env file.
DASHBOARD_PASSWORD=

GMAIL_ONBOARDING_TO_ADDRESS=placeholder-internal-onboarding-address@example.com

# Daily dashboard report
DAILY_DASHBOARD_ENABLED=false
DAILY_DASHBOARD_RECIPIENT=placeholder-internal-report-recipient@example.com
DAILY_DASHBOARD_FROM=
DAILY_DASHBOARD_TIME_ZONE=America/Phoenix
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
